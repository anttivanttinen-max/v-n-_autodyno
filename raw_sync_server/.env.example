# Required secrets - generate strong random values in Railway Variables.
INGEST_KEY=replace-with-long-random-ingest-secret
READ_KEY=replace-with-long-random-read-secret

# Closed beta invitations. Use unique comma-separated codes and a separate strong token secret.
BETA_INVITE_CODES=invite-user-001,invite-user-002
BETA_TOKEN_SECRET=replace-with-long-random-beta-token-secret
BETA_MAX_DEVICES=2

# Vehicle web research. KEEP DISABLED until explicitly approved.
# Uses the OpenAI Responses API with the built-in web_search tool on the SERVER only.
VEHICLE_WEB_SEARCH_ENABLED=false
OPENAI_API_KEY=replace-with-server-side-openai-api-key
VEHICLE_WEB_SEARCH_MODEL=gpt-5

# MotoLab PWA origin allowed to POST/GET from browser.
ALLOWED_ORIGIN=https://anttivanttinen-max.github.io

# Mount the Railway Volume at /data and use the same path here.
DATA_DIR=/data

# 8 MiB default is enough for optional research audio chunks; raise only if needed.
MAX_BODY_BYTES=8388608
